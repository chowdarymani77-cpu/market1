//@version=6
indicator("Triple Top / Bottom Zones", overlay = true, max_bars_back = 500, max_boxes_count = 100, max_lines_count = 100)

int strength = input.int(2, "Pivot candles on each side", minval = 1, maxval = 10)
int spacing = input.int(4, "Minimum bars between touches", minval = 2, maxval = 50)
int maxSpan = input.int(100, "Maximum bars across three touches", minval = 10, maxval = 300)
string toleranceMode = input.string("ATR", "Price tolerance mode", options = ["ATR", "Points"])
float atrTolerance = input.float(0.25, "Maximum price spread: ATR multiple", minval = 0.01, step = 0.05)
float pointsTolerance = input.float(10, "Maximum price spread: points", minval = 0.01)
float depthFactor = input.float(0.5, "Minimum intervening pullback: ATR multiple", minval = 0.05, step = 0.05)
bool sameDay = input.bool(true, "Keep patterns within one IST day")
int life = input.int(50, "Expire active pattern after bars", minval = 1, maxval = 300)

float atr = ta.atr(14)
float tolerance = toleranceMode == "ATR" ? atr * atrTolerance : pointsTolerance
float ph = ta.pivothigh(high, strength, strength)
float pl = ta.pivotlow(low, strength, strength)
int dateKey = year(time, "Asia/Kolkata") * 10000 + month(time, "Asia/Kolkata") * 100 + dayofmonth(time, "Asia/Kolkata")
bool newDay = barstate.isfirst or dateKey != dateKey[1]

var array<float> highs = array.new<float>()
var array<int> highBars = array.new<int>()
var array<float> lows = array.new<float>()
var array<int> lowBars = array.new<int>()

// Evaluate the last three consecutive same-type pivots; do not skip mismatches.
detect(array<float> prices, array<int> bars, bool isTop, float tol, float depth, int gap, int span) =>
    bool found = false
    float upper = na
    float lower = na
    float neck = na
    int first = na
    if array.size(prices) == 3 and not na(tol) and not na(depth)
        first := array.get(bars, 0)
        int middle = array.get(bars, 1)
        int last = array.get(bars, 2)
        upper := array.max(prices)
        lower := array.min(prices)
        if middle - first >= gap and last - middle >= gap and last - first <= span and upper - lower <= tol
            float between1 = na
            float between2 = na
            for offset = bar_index - last + 1 to bar_index - first - 1
                int at = bar_index - offset
                float value = isTop ? low[offset] : high[offset]
                if at < middle
                    between1 := na(between1) ? value : (isTop ? math.min(between1, value) : math.max(between1, value))
                else if at > middle
                    between2 := na(between2) ? value : (isTop ? math.min(between2, value) : math.max(between2, value))
            found := isTop ? lower - between1 >= depth and lower - between2 >= depth : between1 - upper >= depth and between2 - upper >= depth
            neck := isTop ? math.min(between1, between2) : math.max(between1, between2)
    [found, upper, lower, neck, first]

var box topBox = na
var box bottomBox = na
var line topNeckLine = na
var line bottomNeckLine = na
var bool topActive = false
var bool bottomActive = false
var float topEdge = na
var float bottomEdge = na
var float topNeck = na
var float bottomNeck = na
var int topAt = na
var int bottomAt = na
bool newTop = false
bool newBottom = false
bool topBreak = false
bool bottomBreak = false

if barstate.isconfirmed
    if sameDay and newDay
        array.clear(highs)
        array.clear(highBars)
        array.clear(lows)
        array.clear(lowBars)
        topActive := false
        bottomActive := false

    // Retire old patterns before considering new ones on this candle.
    if topActive
        box.set_right(topBox, bar_index)
        line.set_x2(topNeckLine, bar_index)
        if close > topEdge or bar_index - topAt > life
            topActive := false
        else if close < topNeck and close[1] >= topNeck
            topBreak := true
            topActive := false
    if bottomActive
        box.set_right(bottomBox, bar_index)
        line.set_x2(bottomNeckLine, bar_index)
        if close < bottomEdge or bar_index - bottomAt > life
            bottomActive := false
        else if close > bottomNeck and close[1] <= bottomNeck
            bottomBreak := true
            bottomActive := false

    bool eligible = not sameDay or (bar_index >= strength * 2 and dateKey == dateKey[strength * 2])
    if eligible and not na(ph)
        array.push(highs, ph)
        array.push(highBars, bar_index - strength)
        if array.size(highs) > 3
            array.shift(highs)
            array.shift(highBars)
        [found, upper, lower, neck, first] = detect(highs, highBars, true, tolerance, atr * depthFactor, spacing, maxSpan)
        if found and not topActive and close <= upper and close >= neck
            newTop := true
            topActive := true
            topEdge := upper
            topNeck := neck
            topAt := bar_index
            topBox := box.new(first, upper, bar_index, lower, border_color = color.orange, bgcolor = color.new(color.orange, 85))
            topNeckLine := line.new(first, neck, bar_index, neck, color = color.red, style = line.style_dashed)
    if eligible and not na(pl)
        array.push(lows, pl)
        array.push(lowBars, bar_index - strength)
        if array.size(lows) > 3
            array.shift(lows)
            array.shift(lowBars)
        [found, upper, lower, neck, first] = detect(lows, lowBars, false, tolerance, atr * depthFactor, spacing, maxSpan)
        if found and not bottomActive and close >= lower and close <= neck
            newBottom := true
            bottomActive := true
            bottomEdge := lower
            bottomNeck := neck
            bottomAt := bar_index
            bottomBox := box.new(first, upper, bar_index, lower, border_color = color.teal, bgcolor = color.new(color.teal, 85))
            bottomNeckLine := line.new(first, neck, bar_index, neck, color = color.green, style = line.style_dashed)

plotshape(newTop, "Triple top detected", shape.labeldown, location.abovebar, color.orange, text = "TRIPLE\nTOP", textcolor = color.white, size = size.tiny)
plotshape(newBottom, "Triple bottom detected", shape.labelup, location.belowbar, color.teal, text = "TRIPLE\nBOTTOM", textcolor = color.white, size = size.tiny)
plotshape(topBreak, "Top neckline breakdown", shape.triangledown, location.abovebar, color.red, text = "BREAK", size = size.small)
plotshape(bottomBreak, "Bottom neckline breakout", shape.triangleup, location.belowbar, color.lime, text = "BREAK", size = size.small)
alertcondition(newTop, "Triple top detected", "{{ticker}}: three similar swing highs confirmed.")
alertcondition(newBottom, "Triple bottom detected", "{{ticker}}: three similar swing lows confirmed.")
alertcondition(topBreak, "Triple top neckline broken", "{{ticker}}: close crossed below triple-top neckline.")
alertcondition(bottomBreak, "Triple bottom neckline broken", "{{ticker}}: close crossed above triple-bottom neckline.")
